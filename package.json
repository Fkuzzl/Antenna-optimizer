{
  "name": "Antenna-optimizer",
  "version": "1.0.0",
  "description": "Antenna optimizer desktop and mobile control app with MATLAB/HFSS integration",
  "author": "Mario Ma",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "echo \"\n✅ Dependencies installed! Next: npm run setup\"",
    "setup": "node OPEN_THIS/SETUP/quick_setup.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/start-server.js",
    "server-direct": "node server/matlab-server.js",
    "kill-server": "taskkill /F /IM node.exe 2>nul || echo No Node.js processes found",
    "check-connections": "netstat -an | findstr :3001",
    "desktop:dev": "concurrently -k -n SERVER,WEB,ELECTRON -c green,blue,magenta \"npm run server\" \"npm run web -- --port 8081 --host localhost\" \"wait-on tcp:3001 http://localhost:8081 && cross-env ELECTRON_START_URL=http://localhost:8081 electron electron/main.js\"",
    "desktop:clean": "node scripts/clean-electron-build.js",
    "desktop:web:build": "expo export --platform web --output-dir dist-web",
    "desktop:sign:win": "node scripts/sign-windows-installer.js",
    "desktop:pack:win": "npm run desktop:clean && npm run desktop:web:build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis && npm run desktop:sign:win",
    "desktop:pack:win:unsigned": "npm run desktop:clean && npm run desktop:web:build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "desktop:pack:dir": "npm run desktop:clean && npm run desktop:web:build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "cors": "^2.8.5",
    "expo": "~54.0.10",
    "expo-constants": "~18.0.9",
    "expo-document-picker": "^14.0.7",
    "expo-file-system": "^19.0.15",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.8",
    "expo-sharing": "^14.0.7",
    "expo-status-bar": "~3.0.8",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "expo-module-scripts": "^5.0.8",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.fyp.antennaoptimizer",
    "productName": "Antenna Optimizer",
    "asar": false,
    "files": [
      "electron/**/*",
      "dist-web/**/*",
      "server/**/*",
      "scripts/**/*",
      "config/**/*",
      "Function/**/*",
      "OPEN_THIS/SETUP/setup_loader.js",
      "OPEN_THIS/SETUP/requirements.txt",
      "OPEN_THIS/SETUP/setup_variable.template.json",
      "package.json"
    ],
    "directories": {
      "output": "electron-dist"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "Antenna-Optimizer-${version}-Setup.${ext}"
    },
    "nsis": {
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    }
  }
}
